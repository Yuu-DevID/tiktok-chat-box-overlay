TIKTOK_USERNAME=
WS_PORT=8081
HTTP_PORT=8080
EASYDONATE_API_KEY=
TTS_ENGINE_URL=

# Song requests. Required -- without a key the feature stays off rather than
# running unvalidated. Needs YouTube Data API v3 enabled on the project.
# Name searches (`m!p <song>`) are resolved from YouTube's public results page
# and cost no quota; only validation against videos.list does (1 unit each).
YOUTUBE_API_KEY=
# Region checked against a video's regionRestriction before it can be queued.
YOUTUBE_REGION=ID
# Requests longer than this are refused (seconds).
SONG_MAX_DURATION_SEC=600

# 1 = fake follows/gift/chat traffic instead of connecting to TikTok.
# Add MOCK_CHAT=1 to also generate chat, song requests, stickers and joins.
MOCK=0
